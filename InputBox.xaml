<Window x:Name="InputBoxWindow" x:Class="SAQu.InputBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SAQu"
        mc:Ignorable="d"
        PreviewKeyDown="InputBoxWindow_PreviewKeyDown"
        Loaded="InputBoxWindow_Loaded"
        FocusManager.FocusedElement="{Binding ElementName=InputField}"
        x:FieldModifier="public" Height="159" Width="332" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <TextBox Name="InputField" x:FieldModifier="public" TextWrapping="Wrap" Margin="21,40,20,0" Height="20" VerticalAlignment="Top"/>
        <TextBlock Name="CaptionBlock" x:FieldModifier="public" Margin="20,10,21,0" TextWrapping="Wrap" Height="24" VerticalAlignment="Top"/>
        <Button Content="[Enter]" IsDefault="True" Name="EnterButton" x:FieldModifier="public" Click="EnterButton_Click" Margin="102,77,101,0" Height="25" VerticalAlignment="Top"/>
    </Grid>
</Window>
