<Window x:Name="MainWindow1" x:Class="WarningManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WarningManager"
        mc:Ignorable="d"
        Title="אסיפה - הצעות" Height="450" Width="800"
        SizeChanged="suggestionsGrid_SizeChanged"
        FocusManager.FocusedElement="{Binding ElementName=suggestionContentsField}"
        >
    <Grid>
        <Rectangle Height="217" VerticalAlignment="Top" Fill="Silver"/>
        <ComboBox x:Name="suggestionContentsField" Height="29" Margin="95,52,97,0" VerticalAlignment="Top" IsEditable="True" ItemsSource="{Binding Suggestions}" DisplayMemberPath="Contents" FontSize="16" KeyDown="ComboBox_KeyDown" Loaded="ComboBox_Loaded" FlowDirection="RightToLeft"/>
        <TextBlock Height="28" Margin="224,19,224,0" TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Center" FontSize="18"><Run FlowDirection="RightToLeft" Language="he-il" Text="הקלד הצעה"/></TextBlock>
        <ListView x:Name="suggestionsGrid" d:ItemsSource="{d:SampleData ItemCount=5}" ItemsSource="{Binding Suggestions}" Margin="0,109,0,0" FontSize="14" FlowDirection="RightToLeft">
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="suggestionCol" Header="הצעה" Width="300" DisplayMemberBinding="{Binding Contents}"/>
                    <GridViewColumn x:Name="votesCol" Header="קולות" Width="300" DisplayMemberBinding="{Binding Votes}"/>
